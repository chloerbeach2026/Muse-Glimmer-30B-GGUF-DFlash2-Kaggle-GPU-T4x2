# Private Muse-Glimmer agent server defaults; model weights are HF-only and revision-pinned.
# Target GGUF: exact file identity (size + SHA-256 checked at download/start).
MODEL_REPO=bartowski/Muse-Glimmer-30B-GGUF
MODEL_HF_REVISION=16f5840bef28e4018cf41a7ec9709d6fd89176f6
PRIMARY_MODEL_FILE=Muse-Glimmer-30B-Q4_K_M.gguf
MODEL_FILE=Muse-Glimmer-30B-Q4_K_M.gguf
MODEL_SIZE_BYTES=17306324000
MODEL_SHA256=0d3fc85f61d10fdc84072f0bba6005d61c1ac5605a2627b0fd5ea4ff8194c384
MODEL_SOURCE_MODE=hf
MODEL_SELECTION_POLICY=exact
MODEL_LOAD_ONLY=0
MODEL_EXPECTED_SIZE_BYTES=17306324000
MODEL_EXPECTED_SHA256=0d3fc85f61d10fdc84072f0bba6005d61c1ac5605a2627b0fd5ea4ff8194c384
FORCE_MODEL_DOWNLOAD=0
VERIFY_MODEL_SHA256=1
RECOVER_HF_INCOMPLETE=1
HF_ENDPOINT=https://huggingface.co
HF_DOWNLOAD_WORKERS=32
HF_XET_NUM_CONCURRENT_RANGE_GETS=32
HF_XET_HIGH_PERFORMANCE=1
HF_DOWNLOAD_RETRIES=5
HF_RESUME_DOWNLOAD=1
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=60

# DFlash2 speculative draft: official HF repo and immutable revision.
SPECULATIVE_MODE=dflash
DFLASH_HF_MODEL_REPO=meta-models/Muse-Glimmer-30B-GGUF
DFLASH_HF_REVISION=43c7eadd41352a299ea8e0a36b3157978dd63596
DFLASH_HF_FILE=dflash-Muse-Glimmer-30B-Q4_K_M.gguf
DFLASH_MODEL_FILE=Muse-Glimmer-30B-DFlash2-Q4_K_M.gguf
DFLASH_MODEL_SIZE_BYTES=1631208128
DFLASH_MODEL_SHA256=b2e808bf656086fe86bd0d0bd990f01d33e377537a07c02d45371517c8b264ef
DFLASH_MODEL_PATH=
DFLASH_KAGGLE_INPUT_ROOT=
DFLASH_KAGGLE_MODEL_DATASET=
VERIFY_DFLASH_SHA256=1
DFLASH_DRAFT_THREADS=auto
DFLASH_DRAFT_BATCH_THREADS=auto
DFLASH_DRAFT_N_MAX=15
DFLASH_DRAFT_N_MIN=0
DFLASH_DRAFT_P_MIN=0.0
DFLASH_DRAFT_GPU_LAYERS=999
DFLASH_DRAFT_DEVICE=
REQUIRE_FULL_QUALITY_ACCEPTANCE=0

# Vision projector: pinned to the exact HF model revision and verified before serving.
MM_PROJ_REPO=meta-models/Muse-Glimmer-30B-GGUF
MM_PROJ_REVISION=43c7eadd41352a299ea8e0a36b3157978dd63596
MM_PROJ_FILE=mmproj-Muse-Glimmer-30B-Q4_K_M.gguf
MM_PROJ_PATH=
MM_PROJ_SIZE_BYTES=1400328928
MM_PROJ_SHA256=f48b452316f9b213758e8659444029b961a24a07f99a1abb2a9f88b06f7c00c6
MM_PROJ_REQUIRED=1

# Kaggle inputs are deliberately unused for model/runtime weights in HF-only mode.
KAGGLE_INPUT_ROOT=
KAGGLE_MODEL_DATASET=
KAGGLE_RUNTIME_DATASET=
KAGGLE_MODEL_ALIASES=
KAGGLE_RUNTIME_REQUIRE_MANIFEST=0
KAGGLE_RUNTIME_MANIFEST_FILE=runtime-manifest.json
KAGGLE_RUNTIME_COPY_MODE=never
KAGGLE_RUNTIME_CACHE_DIR=/opt/muse-llama-runtime
KAGGLE_SOURCE_BUILD_CACHE_DIR=/opt/muse-llama-source-build
LLAMA_SOURCE_MODE=build

# Build a compatible CUDA llama.cpp runtime from this immutable source commit.
LLAMA_CPP_REPO=https://github.com/z-lab/llama.cpp-fork.git
LLAMA_CPP_REF=64f765f5adefa4620dddda436ce56f1430435536
LLAMA_CPP_EXPECTED_COMMIT=64f765f5adefa4620dddda436ce56f1430435536
LLAMA_MIN_BUILD=10516
LLAMA_BUILD_VARIANT=cuda
CUDA_ARCHITECTURES=75
CUDAToolkit_ROOT=
CUDACXX=
CMAKE_CUDA_COMPILER=

# Validated target deployment: Kaggle GPU T4x2, one active model inference at a time.
CUDA_VISIBLE_DEVICES=0,1
GPU_REQUIRED_COUNT=2
GPU_MIN_VRAM_MIB=14000
GPU_LAYERS=999
GPU_SPLIT_MODE=layer
GPU_TENSOR_SPLIT=1,1
GPU_MAIN=0
GPU_MONITOR_INTERVAL=1.0
NVIDIA_SMI=
NVIDIA_SMI_SEARCH_PATHS=
NVIDIA_DRIVER_LIB_SEARCH_DIRS=
SERVER_HOST=127.0.0.1
SERVER_ALLOW_NONLOOPBACK=0
SERVER_PORT=8088
SERVER_START_TIMEOUT=900
PARALLEL_SLOTS=1
THREADS=auto
BATCH_THREADS=auto
BATCH_SIZE=512
UBATCH_SIZE=128
CONTEXT_SIZE=131072
MAX_TOKENS=131072
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
SEED=42
REASONING_STRENGTH=high
REASONING_BUDGET=0
MIN_ANSWER_TOKENS=1024
REASONING_PRESERVE=0
PROMPT_LIMIT=0
REQUEST_TIMEOUT=3600
AUTO_CONTEXT_FALLBACK=1

# Gateway: long-running agent requests, larger tool transcripts, and a bounded wait queue.
# Timeouts are tuned for sustained agentic coding (Hermes, Claude Code + OmniRoute,
# OpenCode IDE) where reasoning_strength=high can produce long thinking phases and
# multi-step tool loops can take well over an hour.
ADMISSION_QUEUE_SIZE=16
ADMISSION_QUEUE_WAIT_SECONDS=1200
MAX_REQUEST_BYTES=33554432
MAX_MESSAGES=256
MAX_SINGLE_CONTENT=25000000
MAX_AGGREGATE_CONTENT=30000000
MAX_TOOL_CALLS=256
GATEWAY_IDLE_TIMEOUT=600
GATEWAY_HARD_DEADLINE=7200
MONITOR_INTERVAL=1.0
ENABLE_LOAD_BENCH=0
LOAD_BENCH_REPS=2
ENABLE_LLAMA_BENCH=1
LLAMA_BENCH_PROMPT=64
LLAMA_BENCH_GEN=16
LLAMA_BENCH_REPS=1
SOURCE_INTEGRITY_MODE=strict
